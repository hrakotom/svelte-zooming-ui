{
  "name": "svelte-zooming-ui",
  "version": "0.0.46",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hrakotom/svelte-zooming-ui.git"
  },
  "bugs": {
    "url": "https://github.com/hrakotom/svelte-zooming-ui/issues"
  },
  "homepage": "https://github.com/hrakotom/svelte-zooming-ui#readme",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm version patch && git push --follow-tags && npm run package",
    "test": "npm run test:integration && npm run test:unit",
    "test:integration": "playwright test",
    "test:unit": "vitest",
    "lint": "prettier --plugin-search-dir . --check .",
    "format": "prettier --plugin-search-dir . --write ."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "decimal.js": "^10.4.3",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.28.1",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "esm-env": "^1.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "publint": "^0.1.9",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "dependencies": {
    "animejs": "^4.5.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "decimal.js": "^10.4.3",
    "interactjs": "^1.10.19",
    "just-compare": "^2.3.0",
    "lodash": "^4.17.21",
    "pure-uuid": "^1.8.1",
    "sveltedoc-parser": "^4.2.1"
  }
}
